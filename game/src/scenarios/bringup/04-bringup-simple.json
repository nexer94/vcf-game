      "completion": { "kind": "deployment-status", "status": "completed" },
      "points": 25,
      "specRefs": [
        { "spec": "20-deployment", "section": "§4.2", "sources": ["S14"] },
        { "spec": "20-deployment", "section": "§5.1", "sources": ["S14"] }
      ]
    },
    {
      "id": "t-fleet",
      "order": 10,
      "title": "Zkontroluj výslednou fleet",
      "description": "Nová fleet má jednu (první) VCF Instance s management doménou, ve které běží vCenter, NSX, SDDC Manager, VCF Operations a VCF management services.",
