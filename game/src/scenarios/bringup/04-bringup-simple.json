      "completion": { "kind": "check-clean", "check": "validateFleet", "allowWarnings": false, "context": { "clusterModel": "single-rack" } },
      "points": 10,
      "specRefs": [
        { "spec": "20-deployment", "section": "§2.1", "sources": ["S4"] },
        { "spec": "00-architektura", "section": "§2.1", "sources": ["S1"] }
