  "tasks": [
    {
      "id": "t-target",
      "order": 1,
      "title": "Co nasazujeme",
      "description": "Deployment Wizard > VMware Cloud Foundation: „Deploy a new VCF fleet“, na stránce Existing components nic nezaškrtávej (existující vCenter by znamenal konvergenci).",
      "actions": [
        { "kind": "wizard-step", "step": "deployment-wizard-intro" },
        { "kind": "wizard-step", "step": "select-what-to-deploy" },
        { "kind": "wizard-step", "step": "existing-components" }
      ],
      "completion": {
        "kind": "all-of",
        "conditions": [
          { "kind": "spec-field", "path": "target", "oneOf": ["new-fleet"] },
          { "kind": "spec-field", "path": "existing.existingVcfOperations", "oneOf": [false] },
          { "kind": "spec-field", "path": "existing.existingVcenter", "oneOf": [false] }
        ]
      },
      "points": 10,
      "specRefs": [
        { "spec": "20-deployment", "section": "§4.2", "sources": ["S14"] },
        { "spec": "20-deployment", "section": "§2.5", "sources": ["S14", "S28"] }
      ]
    },
    {
      "id": "t-model",
      "order": 2,
      "title": "Deployment model a velikost",
      "description": "Zvol Simple. Pro Simple je ve 9.1.1 k dispozici jen velikost Small.",
      "actions": [{ "kind": "wizard-step", "step": "deployment-model-and-size" }],
      "completion": {
        "kind": "all-of",
        "conditions": [
          { "kind": "spec-field", "path": "model", "oneOf": ["simple"] },
          { "kind": "spec-field", "path": "size", "oneOf": ["small"] }
        ]
      },
      "points": 10,
      "specRefs": [{ "spec": "20-deployment", "section": "§4.2", "sources": ["S14"] }]
    },
    {
      "id": "t-netstorage",
      "order": 3,
      "title": "Síťová konfigurace a typ úložiště",
      "description": "Ponech výchozí síťovou konfiguraci a zvol principal storage podle workbooku. Typ úložiště výchozího clusteru nejde později změnit.",
      "actions": [
        { "kind": "wizard-step", "step": "network-configuration" },
        { "kind": "wizard-step", "step": "storage-type" }
      ],
      "completion": { "kind": "spec-field", "path": "storage.type", "oneOf": ["vsan-esa"] },
      "points": 10,
      "specRefs": [{ "spec": "20-deployment", "section": "§4.2", "sources": ["S14"] }]
    },
    {
      "id": "t-prereq",
      "order": 4,
      "title": "Projdi prerekvizity",
      "description": "Stránka Review the prerequisites – seznam prerekvizit, případně PRE-FILL GENERATED FQDNs IN WIZARD.",
      "actions": [{ "kind": "wizard-step", "step": "review-prerequisites" }],
      "completion": { "kind": "wizard-step-completed", "step": "review-prerequisites" },
      "points": 5,
      "specRefs": [{ "spec": "20-deployment", "section": "§4.2", "sources": ["S14"] }]
    },
    {
      "id": "t-general",
      "order": 5,
      "title": "Obecná konfigurace a hosty",
      "description": "Version, VCF Instance Name (unikátní), Management domain name, DNS, NTP, DNS doména, Autogenerate passwords. Pak ESX host details.",
      "actions": [
        { "kind": "wizard-step", "step": "general-configuration" },
        { "kind": "wizard-step", "step": "esx-host-details" }
      ],
      "completion": { "kind": "wizard-step-completed", "step": "esx-host-details" },
      "points": 10,
      "specRefs": [{ "spec": "20-deployment", "section": "§4.2", "sources": ["S14"] }]
    },
    {
      "id": "t-networks",
      "order": 6,
      "title": "Sítě a IP rozsahy",
      "description": "ESX Management, VCF Management Services IP Range, VCF Automation IP Range (5 IP), vMotion, vSAN a NSX Host Overlay včetně IP inclusion ranges a MTU.",
      "actions": [{ "kind": "wizard-step", "step": "network-details" }],
      "completion": { "kind": "wizard-step-completed", "step": "network-details" },
      "points": 15,
      "specRefs": [
        { "spec": "20-deployment", "section": "§4.2", "sources": ["S14"] },
        { "spec": "20-deployment", "section": "§3.5", "sources": ["S19"] },
        { "spec": "20-deployment", "section": "§6.4", "sources": ["S19"] }
      ]
    },
    {
      "id": "t-components",
      "order": 7,
      "title": "FQDN komponent, vCenter, storage, vDS, NSX, SDDC Manager",
      "description": "Vyplň FQDN management komponent a interní CIDR VCF services runtime, vCenter, jméno datastore, profil distributed switche, NSX Manager (Simple = 1 uzel + VIP) a SDDC Manager.",
      "actions": [
        { "kind": "wizard-step", "step": "vcf-management-components" },
