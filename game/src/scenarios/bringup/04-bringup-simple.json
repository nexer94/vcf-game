      "completion": { "kind": "wizard-step-completed", "step": "sddc-manager-details" },
      "points": 15,
      "specRefs": [
        { "spec": "20-deployment", "section": "§4.2", "sources": ["S14"] },
        { "spec": "20-deployment", "section": "§6.4", "sources": ["S19"] }
      ]
    },
    {
      "id": "t-validate",
      "order": 8,
      "title": "Kontrola a validace",
      "description": "Review deployment information, pak Review validation. Errors oprav a validuj znovu, warnings oprav nebo potvrď (Acknowledge).",
      "actions": [
        { "kind": "wizard-step", "step": "review-deployment-information" },
        { "kind": "wizard-step", "step": "review-validation" },
        { "kind": "deployment-event", "event": "submit-for-review" },
        { "kind": "deployment-event", "event": "start-validation" },
        { "kind": "deployment-event", "event": "acknowledge-warnings" }
      ],
      "completion": { "kind": "deployment-status", "status": "ready-to-deploy" },
      "points": 20,
      "specRefs": [
        { "spec": "20-deployment", "section": "§4.2", "sources": ["S14"] },
        { "spec": "20-deployment", "section": "§5.1", "sources": ["S14", "S15"] }
      ]
    },
    {
      "id": "t-deploy",
      "order": 9,
      "title": "Nasaď",
      "description": "Deploy a sleduj průběh. Pokud úloha selže, najdi ji v panelu Tasks, oprav příčinu a dej Retry.",
      "actions": [
        { "kind": "wizard-step", "step": "deploy" },
        { "kind": "deployment-event", "event": "deploy" },
        { "kind": "deployment-event", "event": "retry" }
