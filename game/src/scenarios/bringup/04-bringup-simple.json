        { "kind": "wizard-step", "step": "storage-details" },
        { "kind": "wizard-step", "step": "distributed-switch" },
        { "kind": "wizard-step", "step": "nsx-manager-details" },
        { "kind": "wizard-step", "step": "sddc-manager-details" }
