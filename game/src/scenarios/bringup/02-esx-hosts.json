  "tasks": [
    {
      "id": "t-install",
      "order": 1,
      "title": "Nainstaluj ESX na esx04",
      "description": "Připoj ESX ISO, nabootuj z něj, projdi instalaci (disk, klávesnice, root heslo, F11) a nastav boot z disku s ESX.",
      "actions": [{ "kind": "model", "action": "install-esx" }],
      "completion": { "kind": "host-state", "hosts": ["esx04"], "require": { "esxInstalled": true } },
      "points": 10,
      "specRefs": [
        { "spec": "20-deployment", "section": "§4.1.1", "sources": ["S8"] },
        { "spec": "20-deployment", "section": "§3.2", "sources": ["S7"] }
      ]
    },
    {
      "id": "t-network",
      "order": 2,
      "title": "Nastav management síť v DCUI",
      "description": "F2 > Configure Management Network: VLAN, statická IPv4, DNS servery a hostname (FQDN). Custom DNS Suffixes musí zůstat prázdné. vmk0 zůstává na vSphere Standard Switchi.",
      "actions": [{ "kind": "model", "action": "configure-host-network" }],
      "completion": {
        "kind": "host-state",
        "hosts": ["esx01", "esx02", "esx03", "esx04"],
        "require": { "networkConfigured": true, "customDnsSuffixesEmpty": true }
      },
      "points": 20,
      "specRefs": [
        { "spec": "20-deployment", "section": "§4.1.2", "sources": ["S9"] },
        { "spec": "20-deployment", "section": "§3.2", "sources": ["S9"] }
      ]
    },
    {
      "id": "t-dns",
      "order": 3,
      "title": "Zkontroluj DNS záznamy hostů",
      "description": "Každé FQDN musí mít forward (A) i reverse (PTR) záznam. Chybějící záznam doplň na DNS serveru firmy.",
      "actions": [{ "kind": "environment", "action": "dns-add-forward" }, { "kind": "environment", "action": "dns-add-reverse" }],
      "completion": {
        "kind": "dns-forward-reverse",
        "fqdns": ["esx01.dc1.vcfhra.cz", "esx02.dc1.vcfhra.cz", "esx03.dc1.vcfhra.cz", "esx04.dc1.vcfhra.cz"]
      },
      "points": 15,
      "specRefs": [{ "spec": "20-deployment", "section": "§3.5", "sources": ["S20"] }]
    },
    {
      "id": "t-ntp",
      "order": 4,
      "title": "Zapni NTP",
      "description": "VMware Host Client > Host > Configure > Time Configuration > Network Time Protocol > Edit: Enable + NTP server. Ověř, že služba běží. Host Client potřebuje funkční management síť.",
      "actions": [{ "kind": "model", "action": "configure-host-ntp" }],
      "completion": {
        "kind": "host-state",
        "hosts": ["esx01", "esx02", "esx03", "esx04"],
        "require": { "ntpRunning": true }
      },
      "points": 15,
      "specRefs": [{ "spec": "20-deployment", "section": "§4.1.3", "sources": ["S10"] }]
    },
    {
      "id": "t-cert",
      "order": 5,
      "title": "Regeneruj self-signed certifikát",
      "description": "Až po nastavení hostname: zapni SSH, spusť /sbin/generate-certificates, rebootuj host a SSH znovu vypni. Původní certifikát má CN localhost.localdomain a installer kontroluje, že CN odpovídá FQDN.",
      "actions": [
        { "kind": "model", "action": "set-host-ssh" },
        { "kind": "model", "action": "regenerate-host-certificate" }
      ],
      "completion": {
        "kind": "host-state",
        "hosts": ["esx01", "esx02", "esx03", "esx04"],
        "require": { "certificateCnMatchesFqdn": true, "sshEnabled": false }
      },
      "points": 25,
      "specRefs": [
        { "spec": "20-deployment", "section": "§4.1.4", "sources": ["S11"] },
        { "spec": "20-deployment", "section": "§3.2", "sources": ["S11"] }
      ]
    },
    {
      "id": "t-hw-quiz",
      "order": 6,
      "title": "Jaké hosty smí být v prvním clusteru?",
      "description": "Ověř si pravidla pro hardware management domény.",
      "actions": [{ "kind": "quiz" }],
      "completion": {
        "kind": "quiz",
        "question": "Která tvrzení platí pro hosty počátečního nasazení management domény? (více odpovědí)",
        "options": [
          "Všichni hosté musí mít jednotný HW profil – heterogenní cluster není podporován.",
          "Hosty mohou být od různých HW vendorů, pokud mají stejnou verzi ESX.",
          "VCF nepodporuje stateless ESX hosty.",
          "Před nasazením musí být vmk0 na vSphere Distributed Switchi."
        ],
        "correct": [0, 2],
        "explanation": "Počáteční nasazení nepodporuje heterogenní clustery a všichni hosté musí být od jednoho vendora; stateless hosty nejsou podporovány. vmk0 musí být na vSphere Standard Switchi – na distributed switch hosty migruje až installer."
      },
      "points": 10,
      "specRefs": [{ "spec": "20-deployment", "section": "§3.2", "sources": ["S7", "S9"] }]
    },
    {
      "id": "t-verify",
      "order": 7,
      "title": "Ověř připravenost hostů",
      "description": "Spusť kontrolu hostů tak, jak je installer kontroluje při validaci (FQDN, DNS, statická IP, NTP, certifikát, vmk0).",
      "actions": [{ "kind": "run-check", "check": "validateEsxHostsForBringup" }],
      "completion": {
        "kind": "check-clean",
        "check": "validateEsxHostsForBringup",
        "allowWarnings": false,
        "context": { "hosts": ["esx01", "esx02", "esx03", "esx04"], "model": "simple", "storage": "vsan-esa" }
      },
      "points": 15,
      "specRefs": [{ "spec": "20-deployment", "section": "§3.2", "sources": ["S7", "S9", "S10", "S11"] }]
    }
  ],
